{
  "name": "glue",
  "version": "0.0.1",
  "private": true,
  "description": "G.L.U.E. — Generalized Layer for Unified Ecosystems. Agent federation and interoperability fabric.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "dev": "npm run dev --workspace=@glue/gateway",
    "lint": "eslint packages/ --ext .ts",
    "format": "prettier --write \"packages/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "vitest": "^1.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
